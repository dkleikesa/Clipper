<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标的背景层：「炭火夜市」配色。

  渐变坐标都铺在可见的中央 72 单位（108 里的 18..90）上，外圈 18 单位是系统的
  视差出血区，铺满 108 让它们自然延伸即可；设计稿 1024 画布上的坐标按
  18 + x * 72/1024 折算到这里。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 底色：深炭棕对角渐变 -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="90"
                android:endY="90"
                android:startX="18"
                android:startY="18"
                android:type="linear">
                <item
                    android:color="#FF3A1A0A"
                    android:offset="0.0" />
                <item
                    android:color="#FF1A0A04"
                    android:offset="0.55" />
                <item
                    android:color="#FF0A0402"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- 碗底暖光：像炭火 / 热气从碗底冒上来 -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="79.88"
                android:gradientRadius="22.5"
                android:type="radial">
                <item
                    android:color="#57FF7A1E"
                    android:offset="0.0" />
                <item
                    android:color="#00FF7A1E"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- 右上冷光：避免一整片死棕 -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="81.28"
                android:centerY="27.84"
                android:gradientRadius="36.56"
                android:type="radial">
                <item
                    android:color="#24FF9A3C"
                    android:offset="0.0" />
                <item
                    android:color="#00FF9A3C"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- 左上柔光 -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="33.47"
                android:centerY="24.33"
                android:gradientRadius="43.59"
                android:type="radial">
                <item
                    android:color="#24FFFFFF"
                    android:offset="0.0" />
                <item
                    android:color="#00FFFFFF"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
